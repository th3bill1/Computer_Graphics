<Window x:Class="Computer_Graphics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Selector" Height="200" Width="300">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
        <TextBlock Text="Choose Task" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Button Content="Tasks 1 and 2" Width="200" Margin="0,0,0,10" Click="Button_Tasks1And2_Click"/>
        <Button Content="Tasks 3 and 4" Width="200" Click="Button_Task3_Click"/>
    </StackPanel>
</Window>
